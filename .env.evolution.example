# Variáveis do docker-compose.evolution.yml (WA-0).
# Copie para .env.evolution e troque por um segredo forte.

# Chave global da Evolution (header `apikey`). Use a MESMA na API:
#   apps/api/.env -> EVOLUTION_API_KEY
EVOLUTION_API_KEY=troque-por-um-segredo-forte

# Versão atual do "WhatsApp Web" (Baileys). A embutida envelhece e o WhatsApp
# recusa a conexão (Connection Failure, sem QR). Descubra a atual com:
#   (Invoke-RestMethod "https://web.whatsapp.com/check-update?version=2.3000.0&platform=web").currentVersion
# e cole aqui no formato 2.3000.XXXXXXXXXX
WA_VERSION=2.3000.1015901307
