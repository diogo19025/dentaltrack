  desligado
  mock
  live

  @@map("integration_mode")
}

/// Gatilho automático (espelha AUTOMATION_KINDS no shared).
enum AutomationKind {
  lembrete_3d
  lembrete_1d
  lembrete_1h
  atraso
  falta
  retorno

  @@map("automation_kind")
}

