// DentalTrack — schema Prisma (Postgres/Supabase).
// F0: base multi-tenant (Clinic + Membership).
// F1 (BE-1.1 — base mínima): Procedure, Conversation, Message, Lead, Appointment.
//   (clinic_settings, tag/conversation_tag e daily_metric chegam em F2/F3.)
// Princípio: toda query é escopada por `clinic_id` (multi-tenant).
// Docs: docs/produto.md § Modelo de dados.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // A URL vem de prisma.config.ts / DATABASE_URL (Prisma 7).
}

/// Tenant raiz — uma clínica odontológica.
model Clinic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  settings           ClinicSettings?
  memberships        Membership[]
  procedures         Procedure[]
  tags               Tag[]
  conversations      Conversation[]
  messages           Message[]
  leads              Lead[]
  appointments       Appointment[]
  conversationTags   ConversationTag[]
  dailyMetrics       DailyMetric[]
  pipelineStages     PipelineStage[]
  pipelineCards      PipelineCard[]
  integrations       ClinicIntegration[]
  automationSettings AutomationSettings?
  outboundMessages   OutboundMessage[]
  optOuts            ContactOptOut[]
  holidays           Holiday[]

  @@map("clinic")
}

/// Tag de interesse configurável pela clínica (F2 · BE-2.3). `keywords` são os
/// gatilhos do auto-tagging (F3). `color` espelha a paleta fixa do design.
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  name      String
  color     TagColor @default(teal)
  category  String?
  keywords  String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  procedures       Procedure[]       @relation("ProcedureTags")
  conversationTags ConversationTag[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("tag")
}

/// Configuração do bot por clínica (1:1) — alimenta o system prompt (BE-1.3).
/// Todos os campos são opcionais: o prompt builder funciona sem settings.
model ClinicSettings {
  id                           String    @id @default(uuid()) @db.Uuid
  clinicId                     String    @unique @map("clinic_id") @db.Uuid
  specialty                    String?
  description                  String?
  assistantName                String?   @map("assistant_name")
  tone                         String?
  greeting                     String?
  // F6 — Mídia da saudação (imagem/vídeo/áudio/catálogo) enviada no 1º contato.
  greetingMediaUrl             String?   @map("greeting_media_url")
  greetingMediaType            String?   @map("greeting_media_type")
  instructions                 String?
  // F2 — Ofertas & disponibilidade (alimentam o system prompt, BE-1.3).
  offerEnabled                 Boolean   @default(false) @map("offer_enabled")
  offerText                    String?   @map("offer_text")
  // F6 — Mídia da oferta global (imagem/vídeo/áudio/catálogo).
  offerMediaUrl                String?   @map("offer_media_url")
  offerMediaType               String?   @map("offer_media_type")
  offerStartsOn                String?   @map("offer_starts_on")
  offerEndsOn                  String?   @map("offer_ends_on")
  /// Linhas de disponibilidade [{ day, hours, open }] — ver @dentaltrack/shared.
  availability                 Json?
  /// Quando o dono respondeu a pergunta do 1º acesso ("já tem um número
  /// dedicado?") — conectando ou dizendo que não tem (F10). NULL = ainda não
  /// perguntamos. Existe para não repetir a pergunta a cada login de quem
  /// respondeu "ainda não".
  whatsappOnboardingAnsweredAt DateTime? @map("whatsapp_onboarding_answered_at")
  /// Último "marcar como visto" do sino de notificações (F11). NULL = nunca
  /// abriu — tudo conta como não lido. Por empresa: o MVP é um dono por clínica.
  notificationsSeenAt          DateTime? @map("notifications_seen_at")
  /// Nome da instância Evolution que atende esta clínica no WhatsApp (WA-1).
  /// Resolve `instância → clínica` no webhook (sem JWT). Único por instância.
  whatsappInstance             String?   @unique @map("whatsapp_instance")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_settings")
}

/// Vínculo entre um usuário do Supabase Auth (auth.users.id) e uma clínica.
/// Base do multi-tenant: o TenantGuard resolve o `clinicId` por aqui.
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  role      Role     @default(owner)
  createdAt DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([userId])
  @@map("membership")
}

/// Item do catálogo da clínica (descrição, faixa de preço, duração).
/// Faixa de preço em centavos para evitar floats; opcional ("a partir de…").
model Procedure {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @map("clinic_id") @db.Uuid
  name            String
  description     String?
  priceMinCents   Int?     @map("price_min_cents")
  priceMaxCents   Int?     @map("price_max_cents")
  durationMinutes Int?     @map("duration_minutes")
  active          Boolean  @default(true)
  // F6 — Oferta personalizada do procedimento (texto + mídia opcional). O agente
  // apresenta esta oferta quando o paciente demonstra interesse no procedimento
  // (direto ou por uma das tags associadas).
  offerText       String?  @map("offer_text")
  offerMediaUrl   String?  @map("offer_media_url")
  offerMediaType  String?  @map("offer_media_type")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  tags         Tag[]         @relation("ProcedureTags")

  @@index([clinicId])
  @@map("procedure")
}

/// Sessão de atendimento. Channel-agnostic (web no MVP; whatsapp pós-MVP).
/// status: em_andamento → agendada (conversão) | abandonada (inatividade).
model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  clinicId      String             @map("clinic_id") @db.Uuid
  leadId        String?            @map("lead_id") @db.Uuid
  channel       Channel            @default(web)
  /// Identidade do contato no canal sem login (WhatsApp = número/JID). NULL no
  /// web (identidade = sessão). Base do lookup `(clinica, canal, telefone)`.
  contactPhone  String?            @map("contact_phone")
  status        ConversationStatus @default(em_andamento)
  lastMessageAt DateTime?          @map("last_message_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages         Message[]
  appointments     Appointment[]
  conversationTags ConversationTag[]
  pipelineCard     PipelineCard?

  @@index([clinicId])
  @@index([clinicId, status])
  @@index([leadId])
  @@index([clinicId, channel, contactPhone])
  @@map("conversation")
}

/// Cada turno persistido (paciente, bot ou system). `clinicId` é denormalizado
/// a partir da conversa para permitir queries escopadas por tenant diretamente.
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  clinicId       String      @map("clinic_id") @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  tokens         Int?
  createdAt      DateTime    @default(now()) @map("created_at")

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([clinicId])
  @@map("message")
}

/// Paciente em potencial capturado pela conversa (PII — ver LGPD no roadmap).
model Lead {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @map("clinic_id") @db.Uuid
  name       String?
  phone      String?
  email      String?
  source     String   @default("web")
  /// Id do paciente no sistema de gestão da empresa (F9). Preenchido pela
  /// sincronização da agenda; é o que evita criar um lead duplicado a cada
  /// consulta importada e o que permite achar o paciente antes de agendar.
  externalId String?  @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  appointments     Appointment[]
  pipelineCards    PipelineCard[]
  outboundMessages OutboundMessage[]

  @@unique([clinicId, externalId])
  @@index([clinicId])
  @@index([clinicId, phone])
  @@map("lead")
}

/// Pedido de agendamento — o evento de conversão. No MVP é um pedido
/// (preferência em texto livre), não um slot real sincronizado.
model Appointment {
  id                     String            @id @default(uuid()) @db.Uuid
  clinicId               String            @map("clinic_id") @db.Uuid
  conversationId         String?           @map("conversation_id") @db.Uuid
  leadId                 String?           @map("lead_id") @db.Uuid
  procedureId            String?           @map("procedure_id") @db.Uuid
  preferredTime          String?           @map("preferred_time")
  notes                  String?
  /// F9 — horário **real** da consulta (UTC no banco; renderizado no fuso da
  /// empresa). NULL enquanto o agendamento for só um `pedido` em texto livre:
  /// sem isto não existe "3 dias antes", nem atraso, nem falta.
  startsAt               DateTime?         @map("starts_at")
  endsAt                 DateTime?         @map("ends_at")
  status                 AppointmentStatus @default(pedido)
  source                 AppointmentSource @default(bot)
  /// Id do agendamento no sistema de gestão (chave da sincronização).
  externalId             String?           @map("external_id")
  professionalExternalId String?           @map("professional_external_id")
  professionalName       String?           @map("professional_name")
  unitExternalId         String?           @map("unit_external_id")
  lastSyncedAt           DateTime?         @map("last_synced_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation     Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  procedure        Procedure?        @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  outboundMessages OutboundMessage[]

  @@unique([clinicId, externalId])
  @@index([clinicId])
  @@index([conversationId])
  @@index([leadId])
  @@index([clinicId, startsAt])
  @@index([clinicId, status, startsAt])
  @@map("appointment")
}

/// Aplicação de uma tag de interesse a uma conversa (F3 · BE-3.1). Gravada pelo
/// auto-tagging com a `confidence` (0..1) retornada pelo LLM. Única por
/// (conversa, tag) — o auto-tagging faz upsert. `clinicId` denormalizado p/
/// queries de métricas (top tags) escopadas por tenant.
model ConversationTag {
  id             String   @id @default(uuid()) @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  confidence     Float    @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@index([clinicId])
  @@index([tagId])
  @@index([conversationId])
  @@map("conversation_tag")
}

/// Pré-agregação diária por clínica (F3 · BE-3.4) — alimenta o dashboard rápido.
/// Preenchida pelo cron (`@nestjs/schedule`). Uma linha por (clínica, dia).
model DailyMetric {
  id                     String   @id @default(uuid()) @db.Uuid
  clinicId               String   @map("clinic_id") @db.Uuid
  date                   DateTime @db.Date
  botMessages            Int      @default(0) @map("bot_messages")
  userMessages           Int      @default(0) @map("user_messages")
  leads                  Int      @default(0)
  conversationsStarted   Int      @default(0) @map("conversations_started")
  conversationsScheduled Int      @default(0) @map("conversations_scheduled")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId])
  @@map("daily_metric")
}

/// Coluna do Funil de atendimento (F7), por clínica. As 5 colunas padrão são
/// provisionadas automaticamente e carregam `systemStage` — a "semântica" que
/// o detector automático reconhece (só elas recebem movimento automático);
/// colunas criadas pelo dono (`systemStage` NULL) são manuais. Colunas padrão
/// podem ser renomeadas, mas não excluídas. `position` ordena o board e define
/// a regra "auto só avança".
model PipelineStage {
  id          String       @id @default(uuid()) @db.Uuid
  clinicId    String       @map("clinic_id") @db.Uuid
  name        String
  position    Int
  systemStage FunnelStage? @map("system_stage")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  clinic Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  cards  PipelineCard[]

  @@unique([clinicId, systemStage])
  @@unique([clinicId, name])
  @@index([clinicId, position])
  @@map("pipeline_stage")
}

/// Card do Funil de atendimento (F7 · kanban). Um contato posicionado numa
/// coluna do pipeline: criado automaticamente pelas conversas do bot
/// (`source=auto`, 1 card por conversa) ou à mão pelo dono (`source=manual`,
/// vinculado a um Lead sem conversa). `stageSource` registra quem fez o último
/// movimento — o detector automático (`ai/stage-detection.ts`) só avança um
/// card, nunca regride, então o posicionamento manual do dono é respeitado.
model PipelineCard {
  id             String         @id @default(uuid()) @db.Uuid
  clinicId       String         @map("clinic_id") @db.Uuid
  conversationId String?        @unique @map("conversation_id") @db.Uuid
  leadId         String?        @map("lead_id") @db.Uuid
  stageId        String         @map("stage_id") @db.Uuid
  source         PipelineSource @default(auto)
  stageSource    PipelineSource @default(auto) @map("stage_source")
  note           String?
  stageUpdatedAt DateTime       @default(now()) @map("stage_updated_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  stage        PipelineStage @relation(fields: [stageId], references: [id])

  @@index([clinicId, stageId])
  @@index([clinicId])
  @@index([leadId])
  @@map("pipeline_card")
}

/// Integração com o sistema de gestão da empresa (F9 · hoje só Clinicorp).
/// `mode` decide de onde vem a agenda: `desligado` mantém a disponibilidade
/// declarada em `/settings`; `mock` usa dados sintéticos determinísticos (é o
/// que permite construir e testar tudo antes de a credencial do cliente chegar,
/// mesmo padrão do `LLM_PROVIDER=mock`); `live` chama a API real.
model ClinicIntegration {
  id             String              @id @default(uuid()) @db.Uuid
  clinicId       String              @map("clinic_id") @db.Uuid
  provider       IntegrationProvider @default(clinicorp)
  mode           IntegrationMode     @default(desligado)
  /// Credenciais cifradas (AES-256-GCM, chave em INTEGRATION_ENCRYPTION_KEY).
  /// Nunca em texto puro e nunca devolvidas por nenhum endpoint.
  credentials    String?
  /// Unidade e profissional padrão escolhidos no wizard de conexão.
  unitId         String?             @map("unit_id")
  professionalId String?             @map("professional_id")
  /// Mapeamento `status externo -> status daqui`: [{ externalId, externalName,
  /// status }]. É Json porque a lista é da conta do cliente, não do domínio —
  /// cada empresa nomeia (e cria) os seus.
  statusMappings Json                @default("[]") @map("status_mappings")
  lastCheckedAt  DateTime?           @map("last_checked_at")
  lastSyncedAt   DateTime?           @map("last_synced_at")
  lastError      String?             @map("last_error")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, provider])
  @@map("clinic_integration")
}

/// Configuração das automações de relacionamento (F9), 1:1 com a empresa.
/// Os textos são do dono da empresa (determinísticos, sem IA) — ele precisa
/// saber exatamente o que sai no nome dele. Ver `automations.ts` no shared.
model AutomationSettings {
  id       String @id @default(uuid()) @db.Uuid
  clinicId String @unique @map("clinic_id") @db.Uuid

  /// Fuso IANA da empresa — âncora de "3 dias antes" e da janela de envio.
  timezone        String  @default("America/Sao_Paulo")
  sendWindowStart String  @default("08:00") @map("send_window_start")
  sendWindowEnd   String  @default("20:00") @map("send_window_end")
  skipHolidays    Boolean @default(true) @map("skip_holidays")
  skipWeekends    Boolean @default(false) @map("skip_weekends")
  /// Teto de mensagens automáticas por dia (higiene anti-ban, WA-4).
  dailyCap        Int     @default(200) @map("daily_cap")

  reminder3dEnabled  Boolean @default(true) @map("reminder_3d_enabled")
  reminder3dTemplate String  @map("reminder_3d_template")
  reminder1dEnabled  Boolean @default(true) @map("reminder_1d_enabled")
  reminder1dTemplate String  @map("reminder_1d_template")
  reminder1hEnabled  Boolean @default(true) @map("reminder_1h_enabled")
  reminder1hTemplate String  @map("reminder_1h_template")

  /// O aviso de atraso nasce **desligado**: só é correto se a recepção marcar a
  /// chegada em tempo real, senão avisa quem já está na sala de espera.
  lateEnabled          Boolean @default(false) @map("late_enabled")
  lateToleranceMinutes Int     @default(15) @map("late_tolerance_minutes")
  lateTemplate         String  @map("late_template")

  noShowEnabled       Boolean @default(true) @map("no_show_enabled")
  noShowAttempts      Int     @default(2) @map("no_show_attempts")
  noShowIntervalHours Int     @default(48) @map("no_show_interval_hours")
  noShowTemplate      String  @map("no_show_template")

  recallEnabled   Boolean  @default(true) @map("recall_enabled")
  recallAfterDays Int      @default(30) @map("recall_after_days")
  /// O que conta como "manutenção" varia por empresa — configurável, não
  /// adivinhado.
  recallKeywords  String[] @default([]) @map("recall_keywords")
  recallTemplate  String   @map("recall_template")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("automation_settings")
}

/// Fila de saída das automações (F9). Toda mensagem proativa nasce aqui como
/// `pendente` e só depois é despachada pelo worker.
///
/// A fila existe por três motivos que não cabiam num `setTimeout`:
/// 1. **idempotência** — `dedupeKey` (ex.: `lembrete_1d:<appointmentId>`) é
///    único por empresa, então reinício de processo, cron sobreposto ou
///    re-sincronização não geram um segundo lembrete;
/// 2. **higiene de envio** — janela de horário, feriado, teto diário e jitter
///    são aplicados no despacho, num lugar só, valendo para toda automação;
/// 3. **auditoria** — o dono vê o que saiu, o que foi suprimido e por quê.
model OutboundMessage {
  id             String         @id @default(uuid()) @db.Uuid
  clinicId       String         @map("clinic_id") @db.Uuid
  kind           AutomationKind
  status         OutboundStatus @default(pendente)
  /// Motivo da supressão (espelha OUTBOUND_SUPPRESSION_REASONS no shared).
  reason         String?
  /// Chave de idempotência por empresa — o coração da fila.
  dedupeKey      String         @map("dedupe_key")
  /// Quando deve sair (já ajustado à janela/feriado no enfileiramento).
  scheduledFor   DateTime       @map("scheduled_for")
  sentAt         DateTime?      @map("sent_at")
  /// Tentativa da cadência (falta: 1..N). Não é retry de transporte.
  attempt        Int            @default(1)
  /// Reenvios por falha de transporte (WhatsApp fora do ar). Diferente de
  /// `attempt`: aqui a mensagem é a mesma, só não saiu.
  retries        Int            @default(0)
  body           String
  phone          String?
  error          String?
  leadId         String?        @map("lead_id") @db.Uuid
  conversationId String?        @map("conversation_id") @db.Uuid
  appointmentId  String?        @map("appointment_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dedupeKey])
  @@index([status, scheduledFor])
  @@index([clinicId, createdAt])
  @@index([appointmentId])
  @@map("outbound_message")
}

/// Descadastro de mensagens automáticas, por telefone e por empresa (F9).
///
/// Até aqui o opt-out era só uma resposta amigável em memória (WA-4) — o que
/// bastava num bot **receptivo**. Com disparo ativo ele vira obrigação: quem
/// pediu para parar não pode voltar a receber depois de um restart.
model ContactOptOut {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  /// Telefone normalizado (só dígitos, com DDI) — mesma forma usada no envio.
  phone     String
  /// Palavra/origem que gerou o descadastro (auditoria).
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, phone])
  @@index([clinicId])
  @@map("contact_opt_out")
}

/// Feriado da empresa (F9). Nacional vem da sincronização automática; local
/// (municipal, recesso, férias) é cadastrado à mão — nenhuma fonte nacional
/// acerta o feriado da cidade, e é justamente ele que fecha a clínica.
model Holiday {
  id        String       @id @default(uuid()) @db.Uuid
  clinicId  String       @map("clinic_id") @db.Uuid
  date      DateTime     @db.Date
  name      String
  scope     HolidayScope @default(local)
  createdAt DateTime     @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, date])
  @@map("holiday")
}

enum Role {
  owner
  staff

  @@map("role")
}

/// Canal de atendimento (espelha CHANNELS em @dentaltrack/shared).
enum Channel {
  web
  whatsapp

  @@map("channel")
}

/// Status da conversa (espelha CONVERSATION_STATUSES em @dentaltrack/shared).
enum ConversationStatus {
  em_andamento
  agendada
  abandonada

  @@map("conversation_status")
}

/// Papel de cada mensagem (espelha MESSAGE_ROLES em @dentaltrack/shared).
enum MessageRole {
  user
  assistant
  system

  @@map("message_role")
}

/// Estágio do Funil de atendimento (espelha FUNNEL_STAGES em @dentaltrack/shared).
