  enviado
  falhou
  cancelado
  suprimido

  @@map("outbound_status")
}

/// Abrangência do feriado (espelha HOLIDAY_SCOPES no shared).
enum HolidayScope {
  nacional
  local

  @@map("holiday_scope")
}
