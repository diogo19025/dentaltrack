# ─── apps/api — variáveis de ambiente (copie para .env) ───
NODE_ENV=development
PORT=3001

# Postgres do Supabase (Project Settings → Database → Connection string).
# Use a connection string "Session"/"Direct" com a senha do banco.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Opcional: apenas projetos com JWT HS256 (legado).
# Project Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=your-jwt-secret

# Origens permitidas no CORS (frontend), separadas por vírgula.
CORS_ORIGIN=http://localhost:3000
