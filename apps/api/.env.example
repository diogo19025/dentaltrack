# ─── apps/api — variáveis de ambiente (copie para .env) ───
NODE_ENV=development
PORT=3001

# Postgres do Supabase (Project Settings → Database → Connection string).
# Use a connection string "Session"/"Direct" com a senha do banco.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Opcional: apenas projetos com JWT HS256 (legado).
# Project Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=your-jwt-secret

# Origens permitidas no CORS (frontend), separadas por vírgula.
CORS_ORIGIN=http://localhost:3000

# ─── IA (provider do chatbot) ───
# Provider do LLM: google (Gemini, padrão) | groq | mock (determinístico, só E2E/testes).
LLM_PROVIDER=google
# Opcional: provider de fallback se o primário falhar (google | groq).
# LLM_FALLBACK_PROVIDER=groq
# Gemini free tier — https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Opcional: sobrescreve o modelo padrão (gemini-2.5-flash).
# GOOGLE_MODEL=gemini-2.5-flash
# Alternativa gratuita (Groq) — https://console.groq.com/keys
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile
# Hardening do provider (opcionais): timeout por chamada e nº de retries.
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2

# ─── F3 (auto-tagging + cron) ───
# Confiança mínima (0..1) para gravar uma tag no auto-tagging. Default 0.6.
# AI_TAG_MIN_CONFIDENCE=0.6
# Horas de inatividade até a conversa virar "abandonada" (cron). Default 24.
# ABANDON_AFTER_HOURS=24
